<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <HBox styleClass="page-header">
        <VBox spacing="4.0">
            <Label text="Products" styleClass="page-title" />
            <Label text="Manage current prices, availability, and stock quantities." styleClass="page-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="New product" onAction="#createProduct" styleClass="primary-button" />
    </HBox>
    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="No products have been created yet." styleClass="secondary-text" />
        </placeholder>
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" />
            <TableColumn fx:id="priceColumn" text="Current Price" />
            <TableColumn fx:id="stockColumn" text="Stock" />
            <TableColumn fx:id="statusColumn" text="Status" />
        </columns>
    </TableView>
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="editButton" text="Edit" onAction="#editProduct" />
        <Button fx:id="updateStockButton" text="Update stock" onAction="#updateStock" />
        <Button fx:id="toggleEnabledButton" text="Disable" onAction="#toggleProductEnabled" />
    </HBox>
</VBox>
