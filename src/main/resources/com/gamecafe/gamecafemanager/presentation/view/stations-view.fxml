<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="30.0" right="34.0" bottom="30.0" left="34.0" />
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0">
            <Label text="Stations" style="-fx-text-fill: #18212f; -fx-font-size: 28px; -fx-font-weight: bold;" />
            <Label text="Manage rentable resources and their hourly prices."
                   style="-fx-text-fill: #667587; -fx-font-size: 13px;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="New station" onAction="#createStation"
                style="-fx-padding: 10 18; -fx-font-weight: bold;" />
    </HBox>
    <TableView fx:id="stationTable" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="No stations have been created yet." />
        </placeholder>
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="190.0" />
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="170.0" />
            <TableColumn fx:id="hourlyRateColumn" text="Hourly Price" prefWidth="135.0" />
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="110.0" />
        </columns>
    </TableView>
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="editButton" text="Edit" onAction="#editStation" />
        <Button fx:id="toggleEnabledButton" text="Disable" onAction="#toggleStationEnabled" />
    </HBox>
</VBox>
