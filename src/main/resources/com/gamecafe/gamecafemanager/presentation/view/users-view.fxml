<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <HBox styleClass="page-header">
        <VBox spacing="4.0">
            <Label text="Users" styleClass="page-title" />
            <Label text="Manage local administrators and cashiers." styleClass="page-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="New user" onAction="#createUser" styleClass="primary-button" />
    </HBox>
    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
        <placeholder><Label text="No users found." styleClass="secondary-text" /></placeholder>
        <columns>
            <TableColumn fx:id="usernameColumn" text="Username" />
            <TableColumn fx:id="roleColumn" text="Role" />
            <TableColumn fx:id="statusColumn" text="Status" />
        </columns>
    </TableView>
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="roleButton" text="Change role" onAction="#changeRole" />
        <Button fx:id="passwordButton" text="Reset password" onAction="#resetPassword" />
        <Button fx:id="toggleEnabledButton" text="Disable" onAction="#toggleEnabled" />
    </HBox>
</VBox>
