<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <HBox styleClass="page-header">
        <VBox spacing="4.0">
            <Label text="Active Sessions" styleClass="page-title" />
            <Label text="Elapsed time is calculated from each persisted start time." styleClass="page-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Refresh sessions" onAction="#reloadSessions" />
    </HBox>
    <TableView fx:id="activeSessionsTable" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="There are no active sessions." styleClass="secondary-text" />
        </placeholder>
        <columns>
            <TableColumn fx:id="stationColumn" text="Station" />
            <TableColumn fx:id="startedColumn" text="Started" />
            <TableColumn fx:id="hourlyRateColumn" text="Hourly Rate" />
            <TableColumn fx:id="elapsedColumn" text="Elapsed" />
            <TableColumn fx:id="statusColumn" text="Status" />
        </columns>
    </TableView>
</VBox>
