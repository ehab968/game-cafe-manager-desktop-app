<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="30.0" right="34.0" bottom="30.0" left="34.0" />
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0">
            <Label text="Active Sessions"
                   style="-fx-text-fill: #18212f; -fx-font-size: 28px; -fx-font-weight: bold;" />
            <Label text="Elapsed time is calculated from each persisted start time."
                   style="-fx-text-fill: #667587; -fx-font-size: 13px;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Refresh sessions" onAction="#reloadSessions" />
    </HBox>
    <TableView fx:id="activeSessionsTable" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="There are no active sessions." />
        </placeholder>
        <columns>
            <TableColumn fx:id="stationColumn" text="Station" prefWidth="170.0" />
            <TableColumn fx:id="startedColumn" text="Started" prefWidth="170.0" />
            <TableColumn fx:id="hourlyRateColumn" text="Hourly Rate" prefWidth="120.0" />
            <TableColumn fx:id="elapsedColumn" text="Elapsed" prefWidth="120.0" />
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="90.0" />
        </columns>
    </TableView>
</VBox>
