<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gamecafe.gamecafemanager.presentation.controller.MainController"
            styleClass="app-shell">
    <left>
        <VBox prefWidth="210.0" styleClass="sidebar">
            <Label fx:id="cafeNameLabel" wrapText="true" styleClass="brand-name" />
            <Label text="MANAGER" styleClass="brand-caption" />
            <Region prefHeight="24.0" />
            <Button fx:id="dashboardNavigationButton" text="Dashboard" onAction="#showDashboard"
                    maxWidth="Infinity" styleClass="navigation-button" />
            <Button fx:id="welcomeNavigationButton" text="Welcome" onAction="#showWelcome"
                    maxWidth="Infinity" styleClass="navigation-button" />
            <Button fx:id="stationsNavigationButton" text="Stations" onAction="#showStations" maxWidth="Infinity"
                    styleClass="navigation-button" />
            <Button fx:id="productsNavigationButton" text="Products" onAction="#showProducts" maxWidth="Infinity"
                    styleClass="navigation-button" />
            <Button fx:id="usersNavigationButton" text="Users" onAction="#showUsers" maxWidth="Infinity"
                    styleClass="navigation-button" />
            <Button fx:id="reportsNavigationButton" text="Reports" onAction="#showReports" maxWidth="Infinity"
                    styleClass="navigation-button" />
            <Button fx:id="settingsNavigationButton" text="Settings" onAction="#showSettings" maxWidth="Infinity"
                    styleClass="navigation-button" />
            <Button fx:id="activeSessionsNavigationButton" text="Active Sessions" onAction="#showActiveSessions"
                    maxWidth="Infinity" styleClass="navigation-button" />
            <Button fx:id="aboutNavigationButton" text="About" onAction="#showAbout"
                    maxWidth="Infinity" styleClass="navigation-button" />
            <Region VBox.vgrow="ALWAYS" />
            <Label fx:id="currentUserLabel" styleClass="sidebar-user" />
            <Label fx:id="currentRoleLabel" styleClass="brand-caption" />
            <Button text="Logout" onAction="#logout" maxWidth="Infinity" styleClass="logout-button" />
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <VBox fx:id="informationPage" alignment="CENTER" maxWidth="640.0" maxHeight="320.0"
                  spacing="14.0" styleClass="information-card">
                <Label fx:id="pageTitle" styleClass="page-title" />
                <Label fx:id="pageDescription" wrapText="true" maxWidth="560.0"
                       styleClass="page-subtitle" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
